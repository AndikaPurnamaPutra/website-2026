section.trusted
  .trusted__inner
    .trusted__header
      p.trusted__eyebrow.text-16.text-muted ( Trusted Clients )
      h2.text-heading-42 Helping startups and enterprises build scalable, future-ready digital products.

    .trusted__clients
      ul.trusted__logos
        each client in clients
          li.trusted__logo
            img(src=`assets/images/clients/${client.file}.svg` alt=client.name style=`--w: ${client.w}; --h: ${client.h};`)
      p.trusted__more.text-16.text-muted and hundred more...

    hr.divider

  //- Without JS the row sits centered like Figma; JS duplicates it into a marquee.
  .trusted__marquee(data-marquee)
    ul.trusted__track(data-marquee-track)
      each item, i in testimonials
        li.testimonial-card(class=item.noise ? "testimonial-card--noise" : null)
          if item.logo.goodAtNumbers
            span.testimonial-card__logo.testimonial-card__logo--gan(role="img" aria-label=item.company)
              span.testimonial-card__gan-mark
              img(src="assets/images/testimonials/good-at-numbers-text.svg" alt="")
          else
            img.testimonial-card__logo(src=`assets/images/testimonials/${item.logo.file}` alt=item.company style=`--w: ${item.logo.w}; --h: ${item.logo.h};` class=item.logo.flip ? "testimonial-card__logo--flip" : null)
          p.testimonial-card__quote!= item.quote
          .testimonial-card__author
            img.testimonial-card__avatar(src=`assets/images/testimonials/avatar-${i + 1}.png` alt="")
            span.testimonial-card__person
              span.testimonial-card__name= item.name
              span.testimonial-card__role= item.role
