//- Work mega menu (Figma "Dropdown - Expand" 1596:442; src/js/work-menu.js).
//- Links are placeholders until the work pages exist. Card set 1 uses the
//- Figma pictures, sets 2-4 the Our Work pictures (user decision).
-
  var workCategories = [["Case Study", 28], ["Live Development", 20], ["Design Showcase", 28]]
  var workSets = [
    ["menu/project-1.webp", "menu/project-2.webp", "menu/project-3.webp"],
    ["work/wellmo.webp", "work/papersky.webp", "work/chainlytics.webp"],
    ["work/nexadash.webp", "work/symata.webp", "work/kidoo.webp"],
    ["work/seafood-sambal.webp", "work/beyond-boundaries.webp", "work/wellmo-2.webp"]
  ]
//- "Career" replaced by "Contact" (user decision).
- var navLinks = [["About", "about.html"], ["Team", "#"], ["Services", "#"], ["Contact", "contact.html"]]

header.site-header(data-header)
  .container.site-header__inner
    a.site-header__logo(href="index.html" aria-label="One Week Wonders — Home")
      img(src="assets/images/logo.svg" width="50.25" height="24" alt="")
    nav(aria-label="Main")
      ul.site-nav
        li.site-nav__item.site-nav__item--work(data-work-menu)
          a.site-nav__link(href="#" aria-expanded="false" aria-controls="work-menu")
            | Work
            img(src="assets/icons/chevron-down.svg" width="16" height="16" alt="")
          .work-menu#work-menu
            //- Its background, on a layer of its own: grows from a small box
            //- under Work as the panel opens (src/js/work-menu.js).
            span.work-menu__bg(aria-hidden="true")
            //- The content, shown through the background's shape as it grows.
            .work-menu__content
              .work-menu__brand
                p.work-menu__title Digital#[br]Expertise
                p.work-menu__copy ©2026  /  One Week Wonders Studio
              ul.work-menu__links
                each category in workCategories
                  li
                    a.work-menu__link(href="#")
                      span= category[0]
                      span.work-menu__count= category[1]
              .work-menu__featured
                .work-menu__sets
                  each set, k in workSets
                    .work-menu__set(class=k === 0 ? "is-active" : null aria-hidden=k === 0 ? null : "true")
                      each image in set
                        a.work-menu__card(href="#" tabindex=k === 0 ? null : "-1")
                          img(src=`assets/images/${image}` alt="" loading="lazy")
                          span.work-menu__badge New
                .work-menu__dots(role="tablist" aria-label="Featured projects")
                  each set, k in workSets
                    button.work-menu__dot(type="button" role="tab" aria-selected=k === 0 ? "true" : "false" aria-label=`Projects ${k + 1}`)
        each link in navLinks
          li.site-nav__item
            a.site-nav__link(href=link[1])= link[0]
    //- Phones (< 744): the links are in a menu of their own (below; plan 32).
    button.site-header__menu-toggle(type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle)
      span.site-header__menu-label
        span Menu
        span(aria-hidden="true") Close

//- The phone menu (src/js/mobile-menu.js): outside the bar, which inverts
//- what is behind it. Work leads to its page (no cards on phones). Below
//- the links, the social links only (user: no email, phone or button).
include site-links
.mobile-menu#mobile-menu(data-mobile-menu hidden)
  nav.mobile-menu__inner(aria-label="Menu")
    ul.mobile-menu__links
      each link in [["Work", "#"]].concat(navLinks)
        li
          a.mobile-menu__link(href=link[1])
            span= link[0]
    .mobile-menu__info
      ul.mobile-menu__list.mobile-menu__list--row
        each link in socialLinks
          li
            a(href=link[1])= link[0]
