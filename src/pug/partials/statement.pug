      //- Fixed line breaks and per-line offsets follow the Figma layout.
      p.statement__text
        span.statement__line.statement__line--1
          span We specialize
          img.statement__icon(src="assets/images/statement/decorative-icon.svg" width="66" height="52" alt="")
