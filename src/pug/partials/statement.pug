            span.statement__folder-pocket
              img.statement__folder-shadow(src="assets/images/statement/folder-shadow.svg" alt="")
              span.statement__folder-crop.statement__folder-crop--inside
                img(src="assets/images/statement/folder.png" alt="")
            span.statement__folder-crop.statement__folder-crop--top
              img(src="assets/images/statement/folder.png" alt="")
          span your project's unique
        = " "
        span.statement__line.statement__line--4 requirements, innovation, and high-quality results.

    +ctaButton("Schedule a call", "contact.html", "Free 15min call")
