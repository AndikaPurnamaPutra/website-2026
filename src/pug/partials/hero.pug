section.hero
  .container.hero__inner
    img.hero__coin(src="assets/images/hero/coin.png" width="448" height="420" alt="")

    .hero__content
      .hero__intro
        h1.hero__title.text-display-80
          //- Black at rest (user decision); src/js/hero-highlight.js runs a
          //- brand-gradient wave through it on load and on hover.
          span.hero__title-accent Elite digital
          |  products
          br
          | designed at venture speed
        ul.hero__social
          li
            a.hero__social-link.hero__social-link--behance(href="https://www.behance.net" target="_blank" rel="noopener" aria-label="Behance")
              img.hero__social-icon--behance(src="assets/icons/behance.png" width="32" height="21" alt="")
          li
            a.hero__social-link.hero__social-link--dribbble(href="https://dribbble.com" target="_blank" rel="noopener" aria-label="Dribbble")
              //- Inline (same paths as assets/icons/dribbble.svg, in currentColor)
              //- so the hover can recolour it.
              include icon-dribbble.svg

      .hero__info
        p.hero__description.text-14.text-medium
          | Strategy, visual systems, branding,
          br
          | and high-end web design. We define your identity and support your growth at every touchpoint.
        .hero__datetime
          p.hero__date.text-14.text-medium(data-hero-date) Wednesday, October 14
          .hero__timezone
            span.hero__timezone-label.text-14.text-medium #{'IDN  /  GMT +7'}
            span.hero__time(data-hero-time) 03:38PM

    .hero__showreel
      //- Muted looping video (the file has audio; it stays muted). The poster is
      //- its first frame. src/js/inview-videos.js plays it only while on screen.
      video.hero__showreel-image(poster="assets/images/hero/showreel-poster.jpg" muted loop playsinline preload="metadata" aria-label="Showreel preview" data-inview-video)
        source(src="assets/images/hero/showreel.mp4" type="video/mp4")
      button.hero__showreel-button.glass-button(type="button")
        span.text-14.text-medium Play Showreel
        img(src="assets/icons/play.svg" width="16" height="16" alt="")

  //- Showreel pop-up (reference from the user: manual.studio). Not in Figma:
  //- dark backdrop from the design system, glass close button like the
  //- showreel button. src/js/hero-showreel.js moves it to <body>, opens it from
  //- the showreel and plays the video with sound.
  .showreel-lightbox(data-showreel-lightbox role="dialog" aria-modal="true" aria-label="Showreel" aria-hidden="true")
    .showreel-lightbox__backdrop
    .showreel-lightbox__stage
      video.showreel-lightbox__video(poster="assets/images/hero/showreel-poster.jpg" controls playsinline preload="none")
        source(src="assets/images/hero/showreel.mp4" type="video/mp4")
    button.showreel-lightbox__close(type="button" aria-label="Close")
      svg(width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true")
        path(d="M1 1l10 10M11 1L1 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round")
