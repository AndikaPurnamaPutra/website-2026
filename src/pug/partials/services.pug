//- Without JS this renders Figma's first frame (1523:3292).
//- src/js/services-scroll.js pins the section and steps through the services.
section.services(data-services data-header-theme="dark" data-header-hide)
  .services__inner
    h2.services__label.text-16.text-muted (What we do)

    .services__cards
      each service in services
        article.services__card
          h3.services__card-title.text-heading-28= service.title
          span.services__card-divider
          ul.services__tags
            each tag in service.tags
              li.services__tag= tag
          p.services__card-text.text-14.text-muted= service.text

    .services__fade

    .services__media
      each service in services
        if service.video
          //- Muted looping video; the poster is its first frame.
          //- src/js/inview-videos.js plays it only while it is on screen.
          video.services__image(poster=`assets/images/services/${service.video}-poster.webp` muted loop playsinline preload="metadata" aria-label=service.alt data-inview-video)
            source(src=`assets/images/services/${service.video}.mp4` type="video/mp4")
        else
          img.services__image(src=`assets/images/services/${service.image}.webp` alt=service.alt loading="lazy")
      //- One link over the pictures (each wrapped, the top one would take
      //- every click); src/js/services-scroll.js points it at the service in
      //- view. Placeholder pages until the service pages exist.
      a.services__link(href=services[0].href aria-label=`View ${services[0].title}` data-services-link=services.map((service) => [service.href, service.title]))

    p.services__note.text-14.text-muted Visual trends evolve, but solid systems don’t age. We build clean digital products designed to scale with your business for years, not just seasons.
