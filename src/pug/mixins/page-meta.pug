//- Page head for SEO and link previews (AGENTS.md §15,
//- docs/implementation/29-seo-performance.md): title, description, Open
//- Graph and Twitter Card, canonical. siteUrl is the live site's address, set
//- once the domain is known (user: later); until then the tags that need a
//- full address (canonical, og:url, og:image) are left out.
- var siteUrl = ""
- var siteName = "One Week Wonders Studio"

mixin pageMeta(title, description, path, options)
  - var opts = options || {}
  - var url = siteUrl ? siteUrl + "/" + (path || "") : null
  title= title
  meta(name="description" content=description)
  if opts.noindex
    meta(name="robots" content="noindex")
  if url
    link(rel="canonical" href=url)
  meta(property="og:type" content="website")
  meta(property="og:site_name" content=siteName)
  meta(property="og:title" content=title)
  meta(property="og:description" content=description)
  if url
    meta(property="og:url" content=url)
    meta(property="og:image" content=siteUrl + "/assets/images/meta/og-image.png")
    meta(property="og:image:width" content="1200")
    meta(property="og:image:height" content="630")
  meta(name="twitter:card" content="summary_large_image")
  meta(name="twitter:title" content=title)
  meta(name="twitter:description" content=description)
  if url
    meta(name="twitter:image" content=siteUrl + "/assets/images/meta/og-image.png")

//- The studio for search engines (schema.org), on the homepage.
mixin organizationData
  - var data = { "@context": "https://schema.org", "@type": "Organization", name: siteName, email: "owwstudio@gmail.com", telephone: "+62 878 869 785 4", address: { "@type": "PostalAddress", streetAddress: "Jl. Raya Tajem No.A09 RT.05 RW.27 Kenayan, Wedomartani, Kec. Ngemplak", addressLocality: "Kab. Sleman", addressRegion: "Daerah Istimewa Yogyakarta", postalCode: "55584", addressCountry: "ID" } }
  if siteUrl
    - data.url = siteUrl
    - data.logo = siteUrl + "/assets/images/logo.svg"
  script(type="application/ld+json")!= JSON.stringify(data)
