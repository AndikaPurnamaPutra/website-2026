//- A link's text that rolls up on hover, a copy coming in from below
//- (reference from the user: jasminegunarto.com, fluid.glass;
//- src/scss/components/_text-roll.scss). The copy is hidden from screen
//- readers.
mixin textRoll(text)
  span.text-roll
    span= text
    span(aria-hidden="true")= text
