include ../mixins/cta-button
include ../mixins/work-carousel
include ../mixins/policy

doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title
      block title
        | OWW
    //- Marks JS as available before the first paint, so styles for the JS
    //- versions (e.g. the Motto lights, hidden until their step) apply at once.
    script document.documentElement.classList.add("js");
    link(rel="stylesheet" href="css/main.css")
  body
    block header
      include ../partials/header
    main
      block content
    include ../partials/footer
    script(type="module" src="js/main.js")
