include ../mixins/cta-button
include ../mixins/work-carousel
include ../mixins/policy
include ../mixins/page-meta

doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    //- Each page gives its title and description (src/pug/mixins/page-meta.pug).
    block meta
      +pageMeta("One Week Wonders Studio", "One Week Wonders Studio™ is a design and development agency in Yogyakarta, Indonesia.", "")
    link(rel="icon" href="favicon.svg" type="image/svg+xml")
    link(rel="apple-touch-icon" href="assets/images/meta/apple-touch-icon.png")
    meta(name="theme-color" content="#ffffff")
    //- Marks JS as available before the first paint, so styles for the JS
    //- versions (e.g. the Motto lights, hidden until their step) apply at once.
    script.
      document.documentElement.classList.add("js");
    //- The preloader, on the homepage only (user): the page fills both blocks
    //- (src/pug/pages/index.pug).
    block preloader-start
    //- The fonts of the first screen (the headings, the menu), fetched with the
    //- page rather than once the CSS is read (AGENTS.md §15).
    link(rel="preload" href="assets/fonts/GeneralSans-Regular.woff2" as="font" type="font/woff2" crossorigin)
    link(rel="preload" href="assets/fonts/Inter-Medium.woff2" as="font" type="font/woff2" crossorigin)
    link(rel="stylesheet" href="css/main.css")
  body
    block preloader
    block header
      include ../partials/header
    main
      block content
    include ../partials/footer
    script(type="module" src="js/main.js")
