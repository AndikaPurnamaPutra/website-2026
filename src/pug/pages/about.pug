extends ../layouts/default

//- Figma: "About" 1734:317 (docs/implementation/19-about.md). Built section
//- by section: Intro, Principles, Gallery, Team.
block meta
  +pageMeta("About — OWW", "Meet One Week Wonders Studio™: the team behind brand identities, websites and apps for digital leaders. See how we work and the principles we work by.", "about.html")

block content
  .about
    section.about-intro
      .container
        h1.about-intro__title.text-heading-42 We Are the Team We Wished#[br]We Could Hire.
        //- Its frame opens as the picture rises in it (src/js/about-intro.js).
        //- The picture is taller than the frame (more of Figma's original
        //- photo above Figma's crop), so it can move in it as the page scrolls.
        .about-intro__photo
          img(src="assets/images/about/team.webp" width="1360" height="728" fetchpriority="high" alt="The One Week Wonders team together outdoors")
        .about-intro__body
          .about-intro__text
            p.about-intro__lead One Week Wonders is a fast-moving creative team built to eliminate the long meetings and endless alignment meeting that keep great ideas grounded.
            p.about-intro__note We work right alongside you, turning months of traditional planning into focused, one-week design sprints that deliver high-end websites, sharp visuals, and digital products ready for the real world.
          //- Calendly comes later (as on Contact); Contact for now.
          .about-intro__cta
            a.button.text-18(href="contact.html")
              +buttonText("Schedule a call")
            p.about-intro__cta-caption Free 15min call

    //- Principles (Figma 1734:383 and "Principles - 1…6" 1678:615 – 1678:660).
    //- Texts 03–06 are still copies of 01 in Figma, and illustrations 2–6
    //- are Figma's temporary screenshots (user decision) until the real
    //- ones exist.
    -
      var execution = ["Execution Over Overhead", ["We replace long discovery phases and heavy layers with high-velocity weekly sprints.", "We focus entirely on shipping production-ready work."]]
      var principles = [
        execution,
        ["Frictionless Infrastructure", ["We work inside your ecosystem using Figma, Webflow, and ClickUp. Every file, layer, and component is organized, clean, and immediately ready for your development team."]],
        execution, execution, execution, execution
      ]

    //- Illustration 01: the "Task Manager" board (Figma P-1 … P-5, 1950:5090,
    //- 1950:5267, 2169:1649, 2169:1931, 2169:2256; docs/implementation/
    //- 33-principles-01-task-manager.md). Built in HTML so it can move; 1em is
    //- one Figma pixel. src/js/principles-scroll.js plays the storyboard.
    mixin tmCard(card)
      .tm-card(class=card.cls data-card=card.key)
        .tm-card__top
          span.tm-tag(class=`tm-tag--${card.tag.toLowerCase()}`)= card.tag
          span.tm-card__title= card.title
        .tm-card__bottom
          .tm-card__meta
            span.tm-due
              img(src="assets/images/about/principles/tm/calendar-small.svg" width="8" height="8" alt="")
              span= card.due
            span.tm-avatars
              img(src="assets/images/about/principles/tm/avatar-1.png" width="10" height="10" alt="")
              img(src="assets/images/about/principles/tm/avatar-2.png" width="10" height="10" alt="")
          if card.progress
            .tm-progress
              span.tm-progress__track
                span.tm-progress__fill(style=`--fill: ${card.fill || card.progress}`)
              span.tm-progress__value= `${card.progress}%`
        +tmMark(card.check || "white", card.circle)

    mixin tmSkeleton(check)
      .tm-card.tm-card--skeleton
        .tm-card__top
          span.tm-sk.tm-sk--tag
          span.tm-sk.tm-sk--line
          span.tm-sk.tm-sk--short
        .tm-card__meta
          span.tm-sk-due
            span.tm-sk.tm-sk--dot
            span.tm-sk.tm-sk--due
          span.tm-sk.tm-sk--pill
        +tmMark(check || "grey")

    //- The round mark at the top right: empty, then its tick.
    mixin tmMark(check, circle)
      span.tm-mark
        img.tm-mark__circle(src=`assets/images/about/principles/tm/${circle || "circle-empty"}.svg` width="18" height="18" alt="")
        img.tm-mark__check(src=`assets/images/about/principles/tm/check-${check}.svg` width="18" height="18" alt="")

    mixin tmColumn(key, icon, label, count)
      .tm-col(data-col=key)
        .tm-col__head
          img(src=`assets/images/about/principles/tm/${icon}.svg` width="12" height="12" alt="")
          span.tm-col__label= label
          span.tm-col__count= count
        .tm-col__cards
          block

    -
      var finalize = { key: "finalize", tag: "Design", title: "Finalize homepage design and interactions", due: "Due Nov 11", progress: 88, fill: 91 }
      var build = { key: "build", tag: "Development", title: "Build product listing page and filtering", due: "Due Nov 11", progress: 50, fill: 59.5 }

    section.principles(data-principles data-header-theme="dark")
      .container.principles__inner
        .principles__text
          //- The section's heading; each principle's title under it (h3).
          h2.principles__intro Hundreds of products later, we’ve cut the noise. Here are the core principles we design by.
          .principles__detail
            ol.principles__numbers
              each principle, i in principles
                li
                  button.principles__number(type="button" class=i === 0 ? "is-active" : null)= String(i + 1).padStart(2, "0")
            .principles__items
              each principle, i in principles
                .principles__item(class=i === 0 ? "is-active" : null)
                  h3.principles__title (#{principle[0]})
                  p.principles__description
                    each line, k in principle[1]
                      if k
                        br
                      = line
        .principles__figures
          //- 01: the "Task Manager" board (mixins above).
          .principles__figure.p-board.is-active(aria-hidden="true" data-story="tasks")
            span.tm-dots
            span.tm-glow
              img(src="assets/images/about/principles/tm/glow-phone.svg" width="992" height="665" alt="")
            .tm-frame
              .tm-window
                img.tm-light(src="assets/images/about/principles/tm/light.svg" width="1100" height="891" alt="")
                .tm-head
                  .tm-head__title
                    span.tm-iconbox
                      img(src="assets/images/about/principles/tm/calendar.svg" width="16" height="16" alt="")
                    span.tm-head__label Task Manager
                  .tm-head__actions
                    span.tm-new
                      img(src="assets/images/about/principles/tm/plus.svg" width="12" height="12" alt="")
                      span New Task
                    span.tm-iconbox
                      img(src="assets/images/about/principles/tm/dots-vertical.svg" width="14" height="14" alt="")
                .tm-cols
                  +tmColumn("backlog", "backlog", "Backlog", "20")
                    +tmCard({ key: "navigation", tag: "Design", title: "Create responsive mobile navigation", due: "Due Nov 12" })
                    +tmSkeleton
                    +tmSkeleton
                  +tmColumn("progress", "in-progress", "In Progress", "3/8")
                    +tmCard(build)
                    span.tm-slot(data-slot)
                    +tmCard(finalize)
                  +tmColumn("done", "completed", "Completed", "4/20")
                    .tm-insert(data-insert="finalize")
                      +tmCard(Object.assign({}, finalize, { key: "finalize-done", progress: 100, fill: 100, cls: "tm-card--chosen" }))
                    .tm-insert(data-insert="build")
                      +tmCard(Object.assign({}, build, { key: "build-done", progress: 0 }))
                    +tmSkeleton
                    +tmSkeleton
            //- The card while it is carried (P-3), and the pointer.
            .tm-float
              +tmCard(Object.assign({}, finalize, { key: "finalize-float", circle: "circle-lifted" }))
            img.tm-cursor(src="assets/images/about/principles/tm/cursor.svg" width="46" height="46" alt="")
            img.tm-grab(src="assets/images/about/principles/tm/grab.svg" width="13" height="13" alt="")
          //- 02: Figma, Webflow and ClickUp join OWW (Figma P-1 1950:6117 …
          //- P-7 1957:7774; docs/implementation/34-principles-02-integrations.md).
          //- The cells: a 7 × 5 grid around OWW (--i, --j from its centre); the
          //- outer ones only show once it shrinks (P-5).
          .principles__figure.p-board(aria-hidden="true" data-story="integrations")
            span.tm-dots
            span.tm-glow.int-glow
              img(src="assets/images/about/principles/tm/glow-phone.svg" width="992" height="665" alt="")
            //- Dots ([x, y, radius, alpha]) and streaks ([x, y, length]) of
            //- "Group 1000005339" at their P-1 places; each glides up on its
            //- own as the tools rise.
            span.int-particles
              each dot in [[215.505, 172.936, 2.66, 0.5], [147.661, 34.587, 2.66, 0.5], [2.66, 91.789, 2.66, 0.5], [114.404, 187.569, 1.33, 0.5], [275.367, 211.514, 1.33, 0.5], [288.67, 81.147, 1.33, 1], [50.55, 2.66, 1.33, 0.5], [248.761, 1.33, 1.33, 0.5]]
                span.int-spark.int-dot(style=`--x: ${dot[0]}; --y: ${dot[1]}; --r: ${dot[2]}; --o: ${dot[3]}`)
              each streak in [[87.8, 247.43, 29.27], [202.2, 203.53, 58.53], [46.56, 86.47, 58.53]]
                span.int-spark.int-streak(style=`--x: ${streak[0]}; --y: ${streak[1]}; --h: ${streak[2]}`)
            .int-grid
              each j in [-2, -1, 0, 1, 2]
                each i in [-3, -2, -1, 0, 1, 2, 3]
                  if i || j
                    span.int-cell(class=Math.abs(i) > 2 || Math.abs(j) > 1 ? "int-cell--outer" : null style=`--i: ${i}; --j: ${j}`)
                      img(src="assets/images/about/principles/int/check.svg" width="20" height="20" alt="")
            span.int-fade
            .int-links
              //- The lines (Figma "Vector 3267", #5D5D5D, and Webflow's line
              //- behind OWW, #575757), one per tool, and the light flowing
              //- down each into OWW (P-3): a few dashes ending at one head
              //- (src/js/principles-scroll.js).
              -
                var lines = [
                  ["figma", "M150.55 154.38V289.19C150.55 302.45 161.3 313.19 174.55 313.19H277", "#617dd3"],
                  ["webflow", "M335 154.38V313.64", "#146ef5"],
                  ["clickup", "M519.45 154.38V289.19C519.45 302.45 508.7 313.19 495.45 313.19H393", "#fe22c9"]
                ]
              //- Each light shows only on the part of its line that is drawn
              //- (its mask follows the line).
              svg.int-streams(viewBox="0 0 670 420" fill="none")
                defs
                  each line in lines
                    mask(id=`int-mask-${line[0]}` maskUnits="userSpaceOnUse" x="0" y="0" width="670" height="420")
                      path(d=line[1] data-wire=line[0] stroke="#fff" stroke-width="4")
                each line in lines
                  path.int-wire(d=line[1] data-wire=line[0])
                each line in lines
                  g.int-stream(stroke=line[2] mask=`url(#int-mask-${line[0]})`)
                    each k in [1, 2, 3, 4, 5, 6]
                      path(d=line[0] === "webflow" ? "M335 154.38V247" : line[1])
            span.int-tool(data-tool="figma")
              img(src="assets/images/about/principles/int/figma.svg" width="48" height="65" alt="")
            span.int-tool(data-tool="webflow")
              img(src="assets/images/about/principles/int/webflow.svg" width="52" height="33" alt="")
            span.int-tool(data-tool="clickup")
              img(src="assets/images/about/principles/int/clickup.svg" width="40" height="48" alt="")
            span.int-oww
              img(src="assets/images/about/principles/int/oww.svg" width="63" height="30" alt="")
            //- P-7's dark, which the next round of the loop lifts from.
            span.int-cover
            img.tm-cursor(src="assets/images/about/principles/tm/cursor.svg" width="46" height="46" alt="")
          each n in [3, 4, 5, 6]
            img.principles__figure(src=`assets/images/about/principle-${n}.webp` width="670" height="420" alt="" loading="lazy")

    //- Gallery (Figma 1734:399): five photos placed freely, [x, y, width,
    //- height] in Figma pixels. "Play Video" is only a label for now (user
    //- decision: the video comes later).
    -
      var photos = [
        ["gallery-1.webp", [0, 0, 1130, 636], "The team together in a field below a mountain"],
        ["gallery-2.webp", [900, 715.63, 460, 589], "Two team members walking along a garden path"],
        ["gallery-3.webp", [0, 988, 805, 411], "Two designers working side by side at a computer"],
        ["gallery-4.webp", [0, 1479, 345, 325], "A desk with screens and collectible figures"],
        ["gallery-5.webp", [440, 1650, 920, 478], "The team working together on their laptops"]
      ]
    section.about-gallery
      //- No title in Figma: one for screen readers and search engines only.
      h2.visually-hidden Gallery
      .container
        .about-gallery__photos
          each photo, i in photos
            figure.about-gallery__photo(style=`--x: ${photo[1][0]}; --y: ${photo[1][1]}; --w: ${photo[1][2]}; --h: ${photo[1][3]}`)
              img(src=`assets/images/about/${photo[0]}` width=photo[1][2] height=photo[1][3] alt=photo[2] loading="lazy")
              if i === 0
                span.about-gallery__play.glass-button
                  span.text-14.text-medium Play Video
                  img(src="assets/icons/play.svg" width="16" height="16" alt="")

