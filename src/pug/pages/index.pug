extends ../layouts/default

//- The preloader plays on the homepage only (user). is-preloading shows it
//- from the first paint (not with reduced motion); src/js/preloader.js
//- removes it when done.
block preloader-start
  script.
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("is-preloading");

block preloader
  include ../partials/preloader

block meta
  +pageMeta("Home — OWW", "One Week Wonders Studio™ is a design and development agency in Yogyakarta, Indonesia, crafting brand identities, websites, apps and AI-powered products.", "")
  +organizationData

block content
  include ../partials/hero
  include ../partials/statement
  include ../partials/services
  include ../partials/our-work
  include ../partials/trusted-clients
  //- Milestone and Motto share one wrapper whose background turns from light
  //- to dark across the whole screen (src/js/motto-scroll.js).
  .tone-shift(data-tone-shift)
    //- Screen-sized texture that stays in view across the wrapper, so the dark
    //- background and its texture arrive together over the whole screen.
    img.tone-shift__texture(src="assets/images/motto/texture.webp" alt="")
    include ../partials/milestone
    include ../partials/motto
