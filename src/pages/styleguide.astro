---
// Temporary page for checking design tokens in the browser. Not linked from
// other pages.
import Default from "../layouts/Default.astro";
import PageMeta from "../components/PageMeta.astro";

const colors = ["ink", "ink-2", "white", "surface-muted", "surface-soft", "divider", "border", "border-row", "border-strong", "border-dark", "link"];
---
<Default>
  <PageMeta slot="meta" title="Styleguide — OWW" description="The design system of the One Week Wonders Studio™ website: type, colours, spacing and components." path="styleguide" noindex />
  <div style="padding: var(--page-gutter); display: grid; gap: var(--space-60);">
    <section>
      <p class="text-16 text-muted">( Fonts )</p>
      <p class="text-heading-42" style="margin-top: var(--space-16);">General Sans 400 — Aa Bb Cc 0123</p>
      <p class="text-heading-42" style="font-weight: 500;">General Sans 500 — Aa Bb Cc 0123</p>
      <p class="text-20 text-regular" style="margin-top: var(--space-16);">Inter 400 — Aa Bb Cc 0123</p>
      <p class="text-20">Inter 500 — Aa Bb Cc 0123</p>
    </section>
    <section>
      <p class="text-16 text-muted">( Type scale )</p>
      <div style="display: grid; gap: var(--space-24); margin-top: var(--space-16);">
        <p class="text-display-80"><span class="text-gradient">Elite digital</span> products designed at venture speed</p>
        <p class="text-display-48">$139M+ / display-48</p>
        <p class="text-heading-42">Thoughtful Design, Real Impact / heading-42</p>
        <p class="text-heading-28">Recently Added / heading-28</p>
        <p class="text-title-22">Brand Strategy / title-22</p>
        <p class="text-title-20">Instagram / title-20</p>
        <p class="text-20">Visual trends evolve, but solid systems don’t age. / text-20</p>
        <p class="text-18">Schedule a call / text-18</p>
        <p class="text-16">( Our Work ) / text-16</p>
        <p class="text-14">We delve into your brand's core values, mission, and vision. / text-14</p>
        <p class="text-14 text-medium">Work · About · Team · Services · Career / text-14 medium</p>
        <p class="text-13">HealthTech Website Design — WELLMO / text-13</p>
        <p class="text-12">Co-founder / text-12</p>
      </div>
    </section>
    <section>
      <p class="text-16 text-muted">( Colors )</p>
      <div style="display: grid; grid-template-columns: repeat(6, 1fr); gap: var(--grid-gutter); margin-top: var(--space-16);">
        {colors.map((color) => (
          <div>
            <div style={`height: 80px; border-radius: var(--radius-sm); border: 1px solid var(--color-divider); background: var(--color-${color});`}></div>
            <p class="text-13" style="margin-top: var(--space-8);">{`--color-${color}`}</p>
          </div>
        ))}
      </div>
    </section>
    <section style="background: var(--color-ink); color: var(--color-white); padding: var(--space-40); border-radius: var(--radius-sm);">
      <p class="text-16 text-muted">( Dark surface )</p>
      <p class="text-heading-42" style="margin-top: var(--space-16);">Design to advocates and investors into
<span class="text-gradient" style="background-image: linear-gradient(185deg, var(--gradient-brand-stops-dark));">believers.</span></p>
      <div style="margin-top: var(--space-24); width: 345px; padding: var(--space-20); background: var(--color-glass); backdrop-filter: blur(var(--blur-glass)); border-radius: var(--radius-sm);">
        <p class="text-heading-28">Branding</p>
        <p class="text-14 text-muted" style="margin-top: var(--space-32);">Glass card: --color-glass + --blur-glass</p>
      </div>
    </section>
    <section>
      <p class="text-16 text-muted">( Radius )</p>
      <div style="display: flex; gap: var(--space-20); margin-top: var(--space-16);">
        <div style="width: 120px; height: 60px; background: var(--color-surface-soft); border-radius: var(--radius-sm);"></div>
        <div style="width: 120px; height: 60px; background: var(--color-surface-soft); border-radius: var(--radius-md);"></div>
        <div style="width: 120px; height: 60px; background: var(--color-surface-soft); border-radius: var(--radius-pill);"></div>
      </div>
    </section>
  </div>
</Default>
