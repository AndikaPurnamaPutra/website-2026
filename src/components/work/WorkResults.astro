---
// Search results and "See all" (Figma 2351:1304 grid, 2351:2330 list,
// 2361:2586 list hover, 2361:2740 none; plan 42, step 6). Every project is
// here once as a card (a group per kind) and once as a list row, hidden;
// src/js/work-search.js shows the ones that match /work?q=… or
// /work?type=…, with the counts, and hides the rest of the page. Hidden
// pictures are not loaded (lazy). The index the search reads is the JSON
// below: per project, its words (title, categories, format, keywords, kind,
// year).
import ProjectCard from "./ProjectCard.astro";
import ButtonText from "../ButtonText.astro";
import { workPage } from "../../data/cms.js";
import { KINDS } from "../../data/work-kinds.js";

const { kinds, projects, empty } = workPage;
// Results list in the sections' order, then drag order (Figma's list).
const ordered = KINDS.flatMap(({ kind }) => projects.map((project, i) => ({ project, i })).filter(({ project }) => project.kind === kind));
const index = projects.map((project) => ({
  kind: project.kind,
  words: [project.title, ...project.categories, project.format, ...project.keywords, kinds[project.kind], project.meta.at(-1)].filter(Boolean).join(" "),
}));
// Cards: Case Study and Live in three columns, Showcase in four (Figma).
const CELL = { caseStudy: [440, 244], live: [440, 244], showcase: [325, 244] };
const SIZES = { caseStudy: "(max-width: 743px) 90vw, (max-width: 1023px) 45vw, 31vw", live: "(max-width: 743px) 90vw, (max-width: 1023px) 45vw, 31vw", showcase: "(max-width: 743px) 90vw, (max-width: 1023px) 45vw, 23vw" };
---
<div class="work-results" data-work-results hidden>
  <div class="container work-results__bar">
    <p class="work-results__summary" aria-live="polite">
      <span class="work-results__label">Showing :</span>
      <span class="work-results__count" data-results-count></span>
      <span class="work-results__dot" aria-hidden="true"></span>
      <span class="work-results__label" data-results-summary></span>
    </p>
    <label class="work-results__view">
      <span class="work-results__label">View mode</span>
      <select class="work-results__select" data-results-view>
        <option value="grid">Grid</option>
        <option value="list">List</option>
      </select>
    </label>
  </div>
  <div data-results-grid>
    {KINDS.map(({ kind, id }) => (
      <section class="work-section work-results__group" id={`results-${id}`} aria-labelledby={`results-${id}-title`} data-results-group={kind}>
        <div class="container">
          <div class="work-section__header">
            <h2 class="work-section-title" id={`results-${id}-title`}>{kinds[kind]}</h2>
          </div>
          <div class={`work-results__cards work-results__cards--${kind}`}>
            {projects.map((project, i) => project.kind === kind && (
              <div class="work-results__item" data-result={i} style={`--w: ${CELL[kind][0]}; --h: ${CELL[kind][1]}`}>
                <ProjectCard project={project} width={CELL[kind][0]} height={CELL[kind][1]} sizes={SIZES[kind]} badge={kind === "live" ? "light" : null} />
              </div>
            ))}
          </div>
        </div>
      </section>
    ))}
  </div>
  <div class="container" data-results-list hidden>
    <ul class="work-list">
      {ordered.map(({ project, i }) => {
        const Tag = project.href ? "a" : "div";
        const link = project.href ? { href: project.href, target: "_blank", rel: "noopener" } : {};
        return (
          <li class="work-list__item" data-result={i} data-kind={project.kind}>
            <Tag class="work-list__row" {...link}>
              <span class="work-list__thumb"><img src={`assets/images/${project.image}-800.webp`} width="140" height="78" alt="" loading="lazy" decoding="async" style={project.focus && `object-position: ${project.focus}`}></span>
              <span class="work-list__title">{project.title}</span>
              <span class="work-list__kind text-muted">{kinds[project.kind]}</span>
              <span class="work-list__meta project-card__meta text-muted">{project.meta.map((word) => <span>{word}</span>)}</span>
            </Tag>
          </li>
        );
      })}
    </ul>
  </div>
  <div class="container work-results__empty" data-results-empty hidden>
    <h2 class="work-results__empty-title">Nothing like “<span data-results-query></span>” yet.</h2>
    <p class="work-results__empty-text">{empty.text}</p>
    <a class="button text-18" href={empty.href}><ButtonText text={empty.button} /></a>
  </div>
  <script type="application/json" data-search-index set:html={JSON.stringify(index).replace(/</g, "\\u003c")}></script>
</div>
