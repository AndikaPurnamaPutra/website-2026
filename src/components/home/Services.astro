---
// Without JS this renders Figma's first frame (1523:3292).
// src/js/services-scroll.js pins the section and steps through the services.
// Videos: muted, looping, the poster their first frame; src/js/inview-videos.js
// plays them only while on screen. One link over the pictures (each wrapped,
// the top one would take every click); services-scroll.js points it at the
// service in view. Placeholder pages until the service pages exist.
import { services } from "../../data/services.js";
---
<section class="services" data-services data-header-theme="dark" data-header-hide>
  <div class="services__inner">
    <h2 class="services__label text-16 text-muted">(What we do)</h2>
    <div class="services__cards">
      {services.map((service) => (
        <article class="services__card">
          <h3 class="services__card-title text-heading-28">{service.title}</h3><span class="services__card-divider"></span>
          <ul class="services__tags">
            {service.tags.map((tag) => <li class="services__tag">{tag}</li>)}
          </ul>
          <p class="services__card-text text-14 text-muted">{service.text}</p>
        </article>
      ))}
    </div>
    <div class="services__fade"></div>
    <div class="services__media">
      {services.map((service) => service.video ? (
        <video class="services__image" poster={`assets/images/services/${service.video}-poster.webp`} muted loop playsinline preload="metadata" aria-label={service.alt} data-inview-video>
          <source src={`assets/images/services/${service.video}.mp4`} type="video/mp4">
        </video>
      ) : (
        <img class="services__image" src={`assets/images/services/${service.image}.webp`} srcset={`assets/images/services/${service.image}-800.webp 800w, assets/images/services/${service.image}.webp 2000w`} sizes="(max-width: 1023.98px) 100vw, 65vw" alt={service.alt} loading="lazy" decoding="async">
      ))}<a class="services__link" href={services[0].href} aria-label={`View ${services[0].title}`} data-services-link={JSON.stringify(services.map((service) => [service.href, service.title]))}></a>
    </div>
    <p class="services__note text-14 text-muted">Visual trends evolve, but solid systems don’t age. We build clean digital products designed to scale with your business for years, not just seasons.</p>
  </div>
</section>
