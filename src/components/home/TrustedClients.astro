---
// Without JS the testimonial row sits centered like Figma; JS duplicates it
// into a marquee (src/js/marquee.js), always at its own pace: the page
// scroll no longer pushes it (user). Content from the CMS (src/data/cms.js):
// 4–20 logos (the last row, when not full, centered) and 3–8 testimonials
// (--count centers the row without JS).
import { trustedSection } from "../../data/cms.js";

const { eyebrow, heading, more, clients, testimonials } = trustedSection;
---
<section class="trusted">
  <div class="trusted__inner">
    <div class="trusted__header">
      <p class="trusted__eyebrow text-16 text-muted">{eyebrow}</p>
      <h2 class="text-heading-42">{heading}</h2>
    </div>
    <div class="trusted__clients">
      <ul class="trusted__logos">
        {clients.map((client) => (
          <li class="trusted__logo" style={`--w: ${client.w}; --h: ${client.h};`}><a class="trusted__logo-link" href={client.href}><img src={`assets/images/${client.logo}.svg`} alt={client.name} loading="lazy"><span class="trusted__logo-more">See More</span></a></li>
        ))}
      </ul>
      <p class="trusted__more text-16 text-muted">{more}</p>
    </div>
    <hr class="divider">
  </div>
  <div class="trusted__marquee" data-marquee="" data-marquee-speed="55">
    <ul class="trusted__track" data-marquee-track style={`--count: ${testimonials.length};`}>
      {testimonials.map((item) => (
        <li class:list={["testimonial-card", item.noise && "testimonial-card--noise"]}>
          <img class="testimonial-card__logo" src={`assets/images/${item.logo}.svg`} alt={item.company} loading="lazy" style={`--w: ${item.w}; --h: ${item.h};`}>
          <p class="testimonial-card__quote" set:html={item.quote}></p>
          <div class="testimonial-card__author"><img class="testimonial-card__avatar" src={`assets/images/${item.avatar}.webp`} alt="" loading="lazy" style={item.avatarFocus && `object-position: ${item.avatarFocus}`}><span class="testimonial-card__person"><span class="testimonial-card__name">{item.name}</span><span class="testimonial-card__role">{item.role}</span></span></div>
        </li>
      ))}
    </ul>
  </div>
</section>
