---
// Figma: Milestones 1574:1160. Values render final without JS;
// src/js/milestone-counter.js counts them up, then runs a gradient wave
// through "$139M+" (black at rest, user decision; Figma shows the gradient).
import { stats } from "../../data/milestone-motto.js";
---
<section class="milestone">
  <div class="container milestone__inner">
    <div class="milestone__intro">
      <p class="milestone__eyebrow text-16 text-muted">( Milestone Achieved )</p>
      <h2 class="text-heading-42">From Concept<br>To Impact</h2>
    </div>
    <div class="milestone__stats" data-milestone>
      <ul class="milestone__list">
        {stats.map((stat) => (
          <li class="milestone__row">
            <p class="milestone__value text-display-48" data-count={stat.value} data-prefix={stat.prefix} data-suffix={stat.suffix} data-wave={stat.gradient ? "" : undefined}><span class="milestone__number">{`${stat.prefix}${stat.value}${stat.suffix}`}</span></p>
            <p class="milestone__label text-16">{stat.label}</p>
          </li>
        ))}
      </ul>
      <p class="milestone__text"><span class="milestone__text-lead">Visual trends evolve, but solid systems don’t age.</span> We build clean digital products designed to scale with your business for years, not just seasons.</p>
    </div>
  </div>
</section>
